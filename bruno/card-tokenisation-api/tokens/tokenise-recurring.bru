meta {
  name: Tokenise PAN
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/tokens
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pan": "5500005555555559",
    "expiryMonth": 6,
    "expiryYear": 2028,
    "cardScheme": "MC"
  }
}

assert {
  res.status: eq 201
  res.body.token: isDefined
  res.body.lastFour: eq 5559
  res.body.cardScheme: eq MC
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("token", res.body.token);
  }
}
