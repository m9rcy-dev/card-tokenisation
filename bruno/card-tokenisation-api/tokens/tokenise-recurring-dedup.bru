meta {
  name: Tokenise PAN - dedup returns same token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/tokens
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pan": "5500005555555559",
    "expiryMonth": 6,
    "expiryYear": 2028,
    "cardScheme": "MC"
  }
}

assert {
  res.status: eq 201
  res.body.token: eq {{token}}
}
