meta {
  name: Tokenise PAN (AMEX 15-digit) - 400 unsupported scheme
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/tokens
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pan": "378282246310005",
    "expiryMonth": 3,
    "expiryYear": 2026,
    "cardScheme": "AMEX"
  }
}

assert {
  res.status: eq 400
}
