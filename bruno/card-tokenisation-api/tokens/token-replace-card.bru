meta {
  name: Replace card (token re-binding)
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/tokens/{{token}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pan": "5105105105105100",
    "cardScheme": "MC",
    "expiryMonth": 6,
    "expiryYear": 2029
  }
}

assert {
  res.status: eq 200
  res.body.token: eq {{token}}
  res.body.lastFour: eq "5100"
  res.body.cardScheme: eq MC
}
