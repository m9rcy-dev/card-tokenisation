meta {
  name: Replace card - 409 new PAN already has a token
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/tokens/{{token}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pan": "5500005555555559",
    "cardScheme": "MC",
    "expiryMonth": 12,
    "expiryYear": 2027
  }
}

assert {
  res.status: eq 409
}
