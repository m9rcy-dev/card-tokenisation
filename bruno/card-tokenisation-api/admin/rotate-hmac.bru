meta {
  name: HMAC Key Rotation - Scheduled
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/keys/hmac-keys/rotate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newKeyAlias": "hmac-key-{{$timestamp}}"
  }
}

assert {
  res.status: eq 202
}
