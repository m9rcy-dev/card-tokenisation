{
  "title": "Card Tokenisation — Load Test",
  "uid": "card-tokenisation",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Throughput (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"card-tokenisation\"}[10s])) by (uri, status)",
          "legendFormat": "{{uri}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "HTTP Response Time Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"card-tokenisation\"}[10s])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"card-tokenisation\"}[10s])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"card-tokenisation\"}[10s])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "HikariCP Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"card-tokenisation\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"card-tokenisation\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"card-tokenisation\"}",
          "legendFormat": "pending (queued)"
        },
        {
          "expr": "hikaricp_connections_max{application=\"card-tokenisation\"}",
          "legendFormat": "pool max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"card-tokenisation\", area=\"heap\"}",
          "legendFormat": "heap used"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"card-tokenisation\", area=\"heap\"}",
          "legendFormat": "heap max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"card-tokenisation\"}",
          "legendFormat": "process CPU"
        },
        {
          "expr": "system_cpu_usage{application=\"card-tokenisation\"}",
          "legendFormat": "system CPU"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } }
    },
    {
      "id": 6,
      "title": "GC Pause Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"card-tokenisation\"}[10s])",
          "legendFormat": "GC pause time/s ({{action}} {{cause}})"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "title": "HTTP Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"card-tokenisation\", status=~\"5..\"}[10s]))",
          "legendFormat": "5xx errors/s"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"card-tokenisation\", status=~\"4..\"}[10s]))",
          "legendFormat": "4xx errors/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 8,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"card-tokenisation\"}",
          "legendFormat": "live threads (carrier)"
        },
        {
          "expr": "jvm_threads_peak_threads{application=\"card-tokenisation\"}",
          "legendFormat": "peak threads"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
